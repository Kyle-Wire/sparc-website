# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The house report (docs/payments.md). Checkout is OFF unless this is exactly "true".
# Turn it on in Vercel's Preview environment, with the store in test mode, to try the flow.
CHECKOUT_ENABLED=

# Stripe (server only, never NEXT_PUBLIC_). Test keys (sk_test_) in Preview; a test-mode
# payment never counts as paid while the key is a live one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The house report's Price id (price_...), $149 USD, its product carrying a tax code.
# The card saved at order is charged this plus Stripe Tax when the report is delivered.
STRIPE_PRICE_REPORT=

# Lemon Squeezy: the old subscription checkout only, switched off. Not used for reports.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PURSUE_MONTHLY=
LEMONSQUEEZY_VARIANT_PURSUE_YEARLY=
LEMONSQUEEZY_VARIANT_CONVERGE_MONTHLY=
LEMONSQUEEZY_VARIANT_CONVERGE_YEARLY=

# Optional: transactional email for waitlist notifications
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=hello@sparclabs.co
# Where signup / demo-request notifications are sent
DEMO_NOTIFY_TO=hello@sparclabs.co
# From address for outgoing email. Use the Resend sandbox until sparclabs.co
# is verified as a sending domain in Resend, then switch to e.g. "SPARC Labs <hello@sparclabs.co>"
RESEND_FROM=SPARC Labs <onboarding@resend.dev>

# Homes for sale (Climate Inspection D42). RentCast free Developer plan; server only,
# never NEXT_PUBLIC_. Set it in Vercel's Production environment ONLY, against the
# production Supabase: the request log there is the one counter, and the database
# stops at 45 in any 31 days and 10 in any day. Previews and local copies refuse
# to call the feed. RENTCAST_ALLOW_NONPROD=1 lifts that, and must only ever be
# used against the production database, or the counters split.
RENTCAST_API_KEY=
RENTCAST_ALLOW_NONPROD=
