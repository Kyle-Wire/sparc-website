{
  "name": "sparc-website",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:placeholders:rendered": "node scripts/check-placeholders-rendered.mjs",
    "check:colors": "node scripts/check-colors.mjs",
    "check:measurements": "node scripts/check-measurements.mjs",
    "check:numerals": "node scripts/check-numerals.mjs",
    "check:design": "npm run check:placeholders && npm run check:measurements && npm run check:numerals && npm run check:colors",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "email:dev": "email dev --dir src/emails --port 3001",
    "email:build": "tsx scripts/render-emails.ts"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.2.4",
    "react-email": "^6.0.8",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
